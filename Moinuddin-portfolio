<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#10100f">
  <title>MD Moinuddin Baidya | Portfolio</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #10100f;
      --panel: #191816;
      --text: #f8f5ef;
      --muted: #aaa69d;
      --accent: #e9a83a;
      --line: rgba(255, 255, 255, .12);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background:
        radial-gradient(ellipse at 80% 0%, rgba(233,168,58,.13), transparent 35%),
        var(--bg);
      color: var(--text);
      font-family: "DM Sans", sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }
    .container { width: min(1080px, 90%); margin: auto; }

    nav {
      position: fixed;
      z-index: 10;
      top: 14px;
      left: 50%;
      transform: translateX(-50%);
      width: min(1080px, 92%);
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(20,19,17,.88);
      border: 1px solid var(--line);
      border-radius: 15px;
      backdrop-filter: blur(14px);
    }

    .logo {
      font: 700 1rem "Space Grotesk", sans-serif;
      white-space: nowrap;
    }
    .logo span { color: var(--accent); }

    .nav-links {
      display: flex;
      gap: 22px;
      color: var(--muted);
      font-size: .9rem;
    }
    .nav-links a:hover { color: white; }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 11px 16px;
      border-radius: 10px;
      background: var(--accent);
      color: #211606;
      font-weight: 700;
      transition: .2s;
    }
    .button:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 28px #e9a83a44;
    }

    .hero {
      min-height: 100vh;
      display: grid;
      align-items: center;
      padding: 120px 0 70px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr .85fr;
      gap: 45px;
      align-items: center;
    }

    .eyebrow { color: var(--accent); margin-bottom: 16px; }

    h1, h2, h3 {
      font-family: "Space Grotesk", sans-serif;
      line-height: 1.12;
    }

    h1 {
      font-size: clamp(2.7rem, 7vw, 5.3rem);
      letter-spacing: -.065em;
    }
    h1 span { color: var(--accent); }

    .intro {
      color: var(--muted);
      max-width: 520px;
      margin: 22px 0 25px;
      font-size: 1.05rem;
    }

    .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
    .secondary { color: var(--muted); }
    .secondary:hover { color: white; }

    .photo-wrap { position: relative; justify-self: center; }

    .avatar {
      width: min(340px, 76vw);
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      overflow: hidden;
      border-radius: 48% 52% 43% 57% / 45% 42% 58% 55%;
      background: linear-gradient(135deg, #f5c400, #e9a83a);
      border: 2px solid #e9a83a88;
      box-shadow: 0 25px 80px #e9a83a22;
      animation: float 5s ease-in-out infinite, morph 9s ease-in-out infinite;
    }

    .avatar img {
      position: absolute;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .avatar span {
      color: #211606;
      font: 700 5rem "Space Grotesk", sans-serif;
    }

    .avatar.has-photo span { display: none; }

    .badge {
      position: absolute;
      bottom: 12px;
      left: -18px;
      padding: 11px 14px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: var(--panel);
      animation: float 4s ease-in-out infinite reverse;
    }
    .badge small { color: var(--muted); }

    section.content-section { padding: 80px 0; }

    .label {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: .15em;
      font-size: .82rem;
    }

    .section-title {
      font-size: clamp(2.1rem, 5vw, 3.3rem);
      margin: 10px 0 14px;
      letter-spacing: -.04em;
    }

    .section-desc {
      color: var(--muted);
      max-width: 600px;
      margin-bottom: 30px;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .card {
      padding: 24px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: linear-gradient(145deg, #ffffff0c, #ffffff03);
    }

    .card p { color: var(--muted); margin-top: 10px; }

    .tags { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 18px; }

    .tag {
      padding: 7px 12px;
      border: 1px solid #e9a83a44;
      border-radius: 30px;
      color: #f4d9a4;
      background: #e9a83a12;
      font-size: .88rem;
    }

    .work-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 17px;
    }

    .work {
      min-height: 235px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      border: 1px solid var(--line);
      border-radius: 17px;
      overflow: hidden;
      transition: transform .3s, border-color .3s;
    }

    .work:hover { transform: translateY(-7px); border-color: var(--accent); }
    .work:nth-child(1) { background: linear-gradient(145deg, #9a6422, #211b13); }
    .work:nth-child(2) { background: linear-gradient(145deg, #77429a, #211b25); }
    .work:nth-child(3) { background: linear-gradient(145deg, #246c65, #14201e); }
    .work small { color: #f2c879; }
    .work h3 { margin-top: 7px; }

    .contact {
      padding: 52px 22px;
      text-align: center;
      border: 1px solid var(--line);
      border-radius: 22px;
      background: radial-gradient(ellipse at top, #e9a83a1e, transparent 65%), var(--panel);
    }

    .contact p {
      color: var(--muted);
      max-width: 500px;
      margin: 15px auto 24px;
    }

    footer {
      padding: 24px 0;
      color: var(--muted);
      text-align: center;
      border-top: 1px solid var(--line);
    }

    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: .7s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    @keyframes float {
      50% { transform: translateY(-12px); }
    }

    @keyframes morph {
      50% { border-radius: 42% 58% 60% 40% / 55% 48% 52% 45%; }
    }

    @media (max-width: 720px) {
      .nav-links { display: none; }
      .hero { text-align: center; }
      .hero-grid, .about-grid { grid-template-columns: 1fr; }
      .photo-wrap { grid-row: 1; margin-bottom: 15px; }
      .intro { margin-left: auto; margin-right: auto; }
      .actions { justify-content: center; }
      .work-grid { grid-template-columns: 1fr; }
      .work { min-height: 200px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>

<body>
  <nav>
    <a class="logo" href="#home">Moinuddin<span>.</span></a>

    <div class="nav-links">
      <a href="#about">About</a>
      <a href="#work">My Work</a>
      <a href="#contact">Contact</a>
    </div>

    <a class="button" href="https://instagram.com/iammoinuuu" target="_blank" rel="noopener">
      Instagram ↗
    </a>
  </nav>

  <main>
    <section class="hero container" id="home">
      <div class="hero-grid">
        <div class="reveal">
          <div class="eyebrow">✦ Video Editor · Content Writer</div>
          <h1>MD MOINUDDIN<br><span>BAIDYA.</span></h1>

          <p class="intro">
            I’m MD Moinuddin Baidya, a video editor and content writer
            passionate about creative content, visual storytelling, and
            bringing fresh ideas to life.
          </p>

          <div class="actions">
            <a class="button" href="#work">Explore My Work ↗</a>
            <a class="secondary" href="https://instagram.com/iammoinuuu" target="_blank" rel="noopener">
              Find me on Instagram ↗
            </a>
          </div>
        </div>

        <div class="photo-wrap reveal">
          <div class="avatar" id="avatar">
            <span>MB</span>
            <img src="profile.jpg" alt="MD Moinuddin Baidya"
                 onload="document.getElementById('avatar').classList.add('has-photo')"
                 onerror="this.style.display='none'">
          </div>
          <div class="badge">🎬 <strong>Creative Creator</strong><br><small>Video Editor · Content Writer</small></div>
        </div>
      </div>
    </section>

    <section class="content-section container" id="about">
      <div class="reveal">
        <div class="label">About me</div>
        <h2 class="section-title">Creative by nature.</h2>
        <p class="section-desc">
          I create engaging videos and meaningful content through creative
          editing, storytelling, and words that connect with people.
        </p>
      </div>

      <div class="about-grid reveal">
        <div class="card">
          <h3>What I do</h3>
          <p>
            I’m a video editor and content writer who enjoys turning ideas
            into creative, engaging content for digital platforms.
          </p>
        </div>

        <div class="card">
          <h3>Creative skills</h3>
          <div class="tags">
            <span class="tag">Video Editing</span>
            <span class="tag">Content Writing</span>
            <span class="tag">Creative Content</span>
            <span class="tag">Visual Storytelling</span>
          </div>
        </div>
      </div>
    </section>

    <section class="content-section container" id="work">
      <div class="reveal">
        <div class="label">Portfolio</div>
        <h2 class="section-title">My creative work.</h2>
        <p class="section-desc">
          A selection of creative work in video editing, writing, and content creation.
        </p>
      </div>

      <div class="work-grid reveal">
        <div class="work">
          <small>Video Editing</small>
          <h3>Video Projects</h3>
        </div>
        <div class="work">
          <small>Content Writing</small>
          <h3>Words & Stories</h3>
        </div>
        <div class="work">
          <small>Creative Content</small>
          <h3>Visual Ideas</h3>
        </div>
      </div>
    </section>

    <section class="content-section container" id="contact">
      <div class="contact reveal">
        <div class="label">Contact</div>
        <h2 class="section-title">Have a creative idea?</h2>
        <p>
          Need a video editor or content writer? Message me on Instagram
          and let’s create something together.
        </p>
        <a class="button" href="https://ig.me/m/iammoinuuu" target="_blank" rel="noopener">
          Message me on Instagram ↗
        </a>
      </div>
    </section>
  </main>

  <footer>© 2026 MD Moinuddin Baidya · Made with creativity</footer>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll(".reveal").forEach((element) => {
      observer.observe(element);
    });
  </script>
</body>
</html>
